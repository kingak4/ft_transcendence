dev-check:
    name: Development build - evaluation
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Setup Dev env
        run: |
          make env
          echo "BACKEND_URL=http://transcend-backend:5000" > frontend/.env
          echo "CODEGEN_URL=https://localhost:8443/api" >> frontend/.env

      - name: Set up Docker Buildx Cache
        uses: docker/setup-buildx-action@v3

      - name: Build backend image
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          file: ./backend/transcend/Dockerfile
          load: true
          tags: transcend-backend:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Mark backend image as freshly built
        run: touch backend/.build.stamp

      - name: Start infra
        working-directory: infra
        run: make up
      
      - name: Start backend
        working-directory: backend
        run: make up

      - name: Verify backend is reachable through nginx (portless dev profile)
        run: |
          echo "Waiting for https://localhost:8443/api/api-docs ..."
          for i in $(seq 1 30); do
            code=$(curl -k -s -o /dev/null -w "%{http_code}" --connect-timeout 2 https://localhost:8443/api/api-docs || true)
            [ "$code" = "200" ] && break
            sleep 1
          done
          if [ "$code" != "200" ]; then
            echo "::error::Backend not reachable through nginx (got $code)"
            exit 1
          fi
          echo "Backend reachable through nginx."

          echo "Checking STOMP endpoint https://localhost:8443/api/ws/info ..."
          stomp_code=$(curl -k -s -o /dev/null -w "%{http_code}" --connect-timeout 2 https://localhost:8443/api/ws/info || true)
          if [ "$stomp_code" != "200" ]; then
            echo "::error::STOMP info endpoint not reachable through nginx (got $stomp_code)"
            exit 1
          fi
          echo "STOMP reachable."

          echo "Asserting backend is NOT directly reachable (portless design) ..."
          for port in 5000 5001; do
            direct=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 http://localhost:$port/actuator/health || true)
            if [ "$direct" != "000" ]; then
              echo "::error::Backend answers directly on :$port (got $direct) — dev profile must be portless"
              exit 1
            fi
          done
          echo "Backend correctly portless — only reachable through nginx."
      
      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: frontend/package-lock.json

      - name: Install dependencies
        working-directory: frontend
        run: npm ci

      - name: Generate API types
        working-directory: frontend
        # Fetches the OpenAPI and AsyncAPI specs through nginx (CODEGEN_URL, set in
        # frontend/.env above), then writes app/types/api.d.ts and asyncapi.d.ts
        run: make generate

      - name: Lint
        working-directory: frontend
        run: npm run lint

      - name: Cache Next.js build
        uses: actions/cache@v4
        with:
          path: frontend/.next/cache
          key: nextjs-${{ runner.os }}-${{ hashFiles('frontend/package-lock.json') }}-${{ hashFiles('frontend/**/*.ts', 'frontend/**/*.tsx') }}
          restore-keys: |
            nextjs-${{ runner.os }}-${{ hashFiles('frontend/package-lock.json') }}-

      - name: Build
        working-directory: frontend
        run: npm run build

      - name: Start frontend (dev container)
        working-directory: frontend
        run: make up

      - name: Verify homepage is served through nginx
        run: |
            echo "Waiting for transcend-frontend to become healthy ..."
            for i in $(seq 1 90); do
              status=$(docker inspect --type container -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' transcend-frontend 2>/dev/null || echo missing)
              [ "$status" = "healthy" ] && break
              [ "$status" = "missing" ] && break
              sleep 1
            done
            if [ "$status" != "healthy" ]; then
              echo "::error::Frontend did not become healthy (last status: $status)"
              docker inspect transcend-frontend || true
            exit 1
          fi
            echo "Frontend healthy."

            code=$(curl -k -s -o /dev/null -w "%{http_code}" --max-time 30 https://localhost:8443/ || true)
            if [ "$code" != "200" ]; then
              echo "::error::Homepage not served through nginx (got $code)"
              exit 1
            fi
          echo "Homepage served through nginx."

      - name: Show backend logs on failure
        if: failure()
        working-directory: backend
        run: docker compose -p transcend -f docker-compose.yml logs transcend-backend

      - name: Show frontend logs on failure
        if: failure()
        working-directory: frontend
        run: docker compose -p transcend -f docker-compose.yml logs transcend-frontend

  local-check:
    name: Local build - making each other happy
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Setup Local env
        run: make env

      - name: Set up Docker Buildx Cache
        uses: docker/setup-buildx-action@v3

      - name: Build backend image
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          file: ./backend/transcend/Dockerfile
          load: true
          tags: transcend-backend:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Mark backend image as freshly built
        run: touch backend/.build.stamp

      - name: Start infra
        working-directory: infra
        run: make up

      - name: Start backend (local profile — published on loopback :5001)
        working-directory: backend
        run: make -f Makefile.dev up

      - name: Verify local topology
        run: |
          echo "Current containers (doc check 1):"
          docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"

          wait_for_healthy() {
            local name="$1"
            local status=""

            for _ in $(seq 1 90); do
              status=$(docker inspect --type container -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$name" 2>/dev/null || echo missing)
              if [ "$status" = "healthy" ]; then
                echo "$name: healthy"
                return 0
              fi
              if [ "$status" = "missing" ]; then
                echo "::error::Container $name is missing"
                return 1
              fi
              sleep 1
            done

            echo "::error::Container $name did not become healthy (last status: $status)"
            docker inspect "$name" || true
            return 1
          }

          echo "Waiting for compose healthchecks ..."
          for name in nginx postgres-db redis-db transcend-backend; do
            wait_for_healthy "$name"
          done

          echo "Asserting backend port is bound to loopback only ..."
          binding=$(docker port transcend-backend 5000 || true)
          if [ "$binding" != "127.0.0.1:5001" ]; then
            echo "::error::Expected backend bound to 127.0.0.1:5001, got: '$binding'"
            exit 1
          fi
          echo "Backend bound to $binding — loopback only, invisible to the network."

          code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 http://localhost:5001/actuator/health || true)
          if [ "$code" != "200" ]; then
            echo "::error::Backend health endpoint failed through the published loopback port (got $code)"
            exit 1
          fi
          echo "Backend healthy on loopback :5001."

          echo "Checking STOMP endpoint http://localhost:5001/ws/info ..."
          stomp_code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 http://localhost:5001/ws/info || true)
          if [ "$stomp_code" != "200" ]; then
            echo "::error::STOMP info endpoint not reachable (got $stomp_code)"
            exit 1
          fi
          echo "STOMP reachable — a host-side 'npm run dev' can work against this backend."

      - name: Show backend logs on failure
        if: failure()
        working-directory: backend
        run: docker compose -p transcend -f docker-compose.yml -f docker-compose.dev.yml logs transcend-backend
