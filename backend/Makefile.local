include .env
include ./../infra/.env
.PHONY: run up build format test docs verify
PROFILE := local
export SPRING_PROFILES_ACTIVE=local

up:
	${GRADLE} bootRun --args='--spring.profiles.active=$(PROFILE)'

build:
	${GRADLE} build

format:
	${GRADLE} spotlessApply

clean:
	${GRADLE} clean

test:
	${GRADLE} jacocoTestReport 

docs:
	${GRADLE} docs

verify:
	${GRADLE} test --tests "code.SpringContextTest"