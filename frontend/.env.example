# What to put in .env.local — depends on where you run commands from:
#
#  ┌─────────────────────────────┬──────────────────────────────────┬──────────────────────────────────────────────────────────────┐
#  │           Scenario          │    value to use for .env.local   │                           Why                                │
#  ├─────────────────────────────┼──────────────────────────────────┼──────────────────────────────────────────────────────────────┤
#  │ Devcontainer (VS Code       │ http://localhost:5001            │ devcontainer.json uses --network=host, so the container      │
#  │ Dev Containers)             │                                  │ shares the host network stack — same loopback as the host.   │
#  ├─────────────────────────────┼──────────────────────────────────┼──────────────────────────────────────────────────────────────┤
#  │ Host terminal (plain        │ http://localhost:5001            │ Running natively — the backend's port is published to        │
#  │ WSL / Linux)                │                                  │ 127.0.0.1 only (loopback), reachable from this same machine. │
#  ├─────────────────────────────┼──────────────────────────────────┼──────────────────────────────────────────────────────────────┤
#  │ Remote machine              │ not directly supported           │ The backend's port is loopback-only on purpose (keeps it     │
#  │                             │                                  │ unreachable from other machines/the network — see the        │
#  │                             │                                  │ project's HTTPS-only-for-external-access requirement).       │
#  │                             │                                  │ Use nginx (https://<machine-ip>:8443/api) if you need this.  │
#  └─────────────────────────────┴──────────────────────────────────┴──────────────────────────────────────────────────────────────┘

BACKEND_URL=http://transcend-backend:5000
